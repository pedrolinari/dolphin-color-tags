+    // Dolphin Color Tags - cached metadata
+    if (roles.isEmpty() || roles.contains("url") || roles.contains("tags")) {
+        QColor color;
+        const QUrl url = m_data.value("url").toUrl();
+
+        if (url.isLocalFile()) {
+            KFileMetaData::UserMetaData metadata(url.toLocalFile());
+            // Color Tags V0.2 registry
+            static QSettings config(
+                QDir::homePath() + QStringLiteral("/.config/dolphin-colortagsrc"),
+                QSettings::IniFormat);
+
+            static QElapsedTimer refreshTimer;
+
+            if (!refreshTimer.isValid() || refreshTimer.elapsed() > 1000) {
+                config.sync();
+                refreshTimer.restart();
+            }
+
+            QStringList tags = metadata.tags();
+
+            // Color Tags V0.3 priority
+            auto priority = [](const QString &tag) {
+                const QString name = tag.toLower();
+
+                if (name.contains(QStringLiteral("remover")))
+                    return 0;
+                if (name.contains(QStringLiteral("modificado")))
+                    return 1;
+                if (name.contains(QStringLiteral("adicionado")))
+                    return 2;
+                if (name.contains(QStringLiteral("personalizado")))
+                    return 3;
+                if (name.contains(QStringLiteral("original")))
+                    return 5;
+
+                return 4;
+            };
+
+            std::stable_sort(tags.begin(), tags.end(),
+                [priority](const QString &a, const QString &b) {
+                    return priority(a) < priority(b);
+                });
+
+            if (config.value(QStringLiteral("Appearance/Enabled"), true).toBool()) {
+                for (const QString &tag : tags) {
+                    color = QColor(config.value(
+                        QStringLiteral("Colors/") + tag).toString());
+
+                    if (color.isValid())
+                        break;
+
+                    const QString name = tag.toLower();
+
+                    if (name.contains(QStringLiteral("original")))
+                        color = QColor("#22c55e");
+                    else if (name.contains(QStringLiteral("adicionado")))
+                        color = QColor("#3b82f6");
+                    else if (name.contains(QStringLiteral("modificado")))
+                        color = QColor("#f59e0b");
+                    else if (name.contains(QStringLiteral("remover")))
+                        color = QColor("#ef4444");
+                    else if (name.contains(QStringLiteral("personalizado")))
+                        color = QColor("#a855f7");
+
+                    if (color.isValid())
+                        break;
+                }
+            }
+        }
+
+        setProperty("colorTagsBackground", color);
+    }
+
     update();
 }
 
